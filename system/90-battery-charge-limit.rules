# Lets members of the wheel group set the battery charge thresholds,
# which the shell's "Charge limit" setting writes to.
SUBSYSTEM=="power_supply", KERNEL=="BAT*", RUN+="/bin/sh -c 'chgrp wheel /sys%p/charge_control_end_threshold /sys%p/charge_control_start_threshold; chmod 664 /sys%p/charge_control_end_threshold /sys%p/charge_control_start_threshold'"
